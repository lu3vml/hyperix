#!/usr/bin/env bash
# hyprix-shot region|screen|window — captura, copia al portapapeles y (según ajustes) edita
# Ajustes (Super+Coma → Sistema): SHOT_DIR, SHOT_EDIT = preguntar | siempre | nunca
SHOT_DIR=""; SHOT_EDIT=preguntar
# shellcheck disable=SC1091
[[ -f "$HOME/.config/hyprix/settings.conf" ]] && source "$HOME/.config/hyprix/settings.conf"
dir=${SHOT_DIR:-"$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Capturas"}
mkdir -p "$dir"
f="$dir/captura-$(date +%Y%m%d-%H%M%S).png"

case "${1:-region}" in
  region) g=$(slurp -d) || exit 0; grim -g "$g" "$f" ;;
  window) g=$(hyprctl -j activewindow | python3 -c 'import json,sys;w=json.load(sys.stdin);print("%d,%d %dx%d" % (w["at"][0], w["at"][1], w["size"][0], w["size"][1]))') \
            && grim -g "$g" "$f" ;;
  screen) grim "$f" ;;
esac
[[ -s $f ]] || exit 1
wl-copy < "$f"

case $SHOT_EDIT in
  siempre) setsid -f swappy -f "$f" >/dev/null 2>&1 ;;
  nunca)   notify-send -t 4000 -i "$f" "Captura copiada" "$(basename "$f")" ;;
  *)       # click en el aviso = editar con swappy (recortar, flechas, texto, difuminar)
    (
      act=$(notify-send -t 7000 -i "$f" -A "default=Editar" \
            "Captura copiada" "$(basename "$f")  ·  click para editar")
      [[ $act == default ]] && swappy -f "$f"
    ) >/dev/null 2>&1 & ;;
esac
